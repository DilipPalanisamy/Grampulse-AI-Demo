# =============================================================================
# GramPulse AI - React Frontend Multi-Stage Production Dockerfile
# =============================================================================

# --- Stage 1: Build React Production Assets ---
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci || npm install

# Copy source files
COPY . .

# Build-time environment arguments
ARG VITE_API_BASE_URL
ARG VITE_GOOGLE_CLIENT_ID=490045634434-h09m0avfvfkcfcj06vpcg4hk1v1q2jq1.apps.googleusercontent.com

ENV VITE_API_BASE_URL=$VITE_API_BASE_URL \
    VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID

# Build Vite bundle
RUN npm run build

# --- Stage 2: Serve Production Assets with Nginx ---
FROM nginx:alpine

# Copy compiled assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy Nginx SPA configuration
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
